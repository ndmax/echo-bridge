# Copy to .env and fill in. Never commit .env.

# Required: shared secret Hubitat sends as "Authorization: Bearer <token>".
# Generate with: openssl rand -hex 32
BRIDGE_TOKEN=

# Where the bridge API listens (npm start only; the Docker image always uses 0.0.0.0:3456).
# Use an address your HTTPS reverse proxy can reach.
HOST=127.0.0.1
PORT=3456

# Optional comma-separated Echo serial numbers that may be targeted (empty = any on the account).
ALLOWED_DEVICE_IDS=

# Comma-separated hostnames allowed in playMp3 URLs (empty = MP3 playback disabled).
MEDIA_HOST_ALLOWLIST=

# Limits (defaults shown).
MAX_TEXT_LENGTH=250
MAX_ZONE_SIZE=10
MAX_URL_LENGTH=200
RATE_LIMIT_PER_MINUTE=6
RATE_LIMIT_BURST=3
THROTTLE_COOLDOWN_SECONDS=60

# Amazon region settings.
AMAZON_PAGE=amazon.com
ALEXA_LOCALE=en-US

# Amazon session file (npm start only; Docker uses /app/data). Contains cookies: keep it private.
COOKIE_FILE=./data/alexa-cookie.json

# Login proxy (used only while running "npm run login"): the LAN IP/hostname your browser uses
# to reach this machine, and the port to open.
LOGIN_PROXY_IP=
LOGIN_PROXY_PORT=3457
# Interface the login proxy listens on (0.0.0.0 = all; use a specific LAN IP to narrow it).
LOGIN_PROXY_BIND=0.0.0.0

# ---- Docker Compose / Portainer only (ignored by "npm start") ----
# Host user/group that owns DATA_DIR (Unraid: usually 99 / 100).
PUID=1000
PGID=1000
# Host folder for the Amazon session (e.g. /mnt/user/appdata/echo-bridge on Unraid).
DATA_DIR=./data
# Host port for the bridge API.
BRIDGE_PORT=3456
