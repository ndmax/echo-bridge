# Copy to .env and fill in. Never commit .env.

# Required: shared secret Hubitat sends as "Authorization: Bearer <token>".
# Generate with: openssl rand -hex 32
BRIDGE_TOKEN=

# Where the bridge API listens. Keep it on loopback/LAN; NGINX Proxy Manager adds HTTPS.
HOST=127.0.0.1
PORT=3456

# Optional comma-separated Echo serial numbers that may be targeted (empty = any on the account).
ALLOWED_DEVICE_IDS=

# Comma-separated hostnames allowed in playMp3 URLs (empty = MP3 playback disabled).
MEDIA_HOST_ALLOWLIST=

# Limits (defaults shown).
MAX_TEXT_LENGTH=250
MAX_ZONE_SIZE=10
MAX_URL_LENGTH=200
RATE_LIMIT_PER_MINUTE=6
RATE_LIMIT_BURST=3
THROTTLE_COOLDOWN_SECONDS=60

# Amazon region settings.
AMAZON_PAGE=amazon.com
ALEXA_LOCALE=en-US

# Amazon session file (contains cookies; keep it out of Git and readable only by the bridge user).
COOKIE_FILE=./data/alexa-cookie.json

# Login proxy (used only while running "npm run login"): the LAN IP/hostname your browser uses
# to reach this machine, and the port to open.
LOGIN_PROXY_IP=
LOGIN_PROXY_PORT=3457
